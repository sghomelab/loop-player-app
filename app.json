{
  "expo": {
    "name": "Loop Deck",
    "icon": "./assets/icon.png",
    "slug": "loop-player",
    "version": "1.0.2",
    "orientation": "portrait",
    "scheme": "loopplayer",
    "userInterfaceStyle": "dark",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0D1117"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.nurlogic.loopplayer",
      "buildNumber": "7",
      "infoPlist": {
        "UIUserInterfaceStyle": "Dark",
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D1117"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.nurlogic.loopplayer",
      "versionCode": 6,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-audio",
      "expo-font",
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "8d203426-ace2-4ce1-8041-1afea620b6f9"
      }
    },
    "owner": "sghomelab"
  }
}
